# .env.example — 이 파일을 복사해 .env로 만든 뒤 실제 값을 채워주세요.
# cp .env.example .env

# DB (RDS)
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/onna
DB_USERNAME=
DB_PASSWORD=

# JWT
JWT_SECRET=

# OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Cookie / CORS
OAUTH_SUCCESS_REDIRECT_URI=
OAUTH_FAILURE_REDIRECT_URI=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=
